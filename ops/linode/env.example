# Copy this to /etc/c4/env on the arena box (cloud-init already creates the
# file with placeholders -- this is just for reference / local editing before
# you paste it in). Root-owned, mode 0600, readable by the c4 user via group.
#
#   sudo install -m 0600 -o c4 -g c4 env.example /etc/c4/env
#   sudo editor /etc/c4/env   # fill in real values
#   sudo systemctl restart c4-watch
#
# Never commit a filled-in copy of this file.

# --- Private repo checkout (DevDogsUGA/c4, this monorepo) ---
# Fine-grained GitHub PAT, `contents: read` on DevDogsUGA/c4 only. Used as the
# clone/pull credential; never written into .git/config (passed via a
# short-lived credential helper / URL rewrite at clone time only).
C4_REPO_TOKEN=

# --- Registry Worker (c4-registry) ---
WORKER_URL=https://c4-registry.example.workers.dev
C4_ROSTER_TOKEN=
RESULTS_TOKEN=

# --- Backup roster (Apps Script web app `doGet`) ---
# Full exec URL, without the ?token= suffix -- scripts append it.
BACKUP_ROSTER_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# --- Notifications ---
DISCORD_WEBHOOK_URL=

# --- GitHub (used for `git ls-remote` rate-limit headroom / private team repos if any) ---
GITHUB_TOKEN=

# --- R2 upload (tournament bundle) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=c4-tournament-bundles

# --- arena-watch (apps/arena-watch) ---
# Set to 1 to let c4-watch.service actually poll + validate. Leave at 0 until
# the submission window opens so it doesn't chew CPU during setup/rehearsal.
C4_WATCH_ENABLED=0
C4_ENGINE_BIN=/opt/c4/c4/apps/match-engine/dist/cli.js
C4_WATCH_STATE_FILE=/var/lib/c4/arena-watch-state.json
C4_WATCH_POLL_INTERVAL_MS=60000
C4_WATCH_CONCURRENCY=4

# --- Presenter (used only by ops/linode/bin/c4-tournament to print the URL) ---
PRESENTER_ORIGIN=http://localhost:5173

{
  "name": "@acm-uga/c4-theme",
  "version": "1.0.0",
  "description": "Shared design tokens (colors, fonts) and board theme for the presenter and testground apps",
  "private": true,
  "type": "module",
  "files": ["theme.css", "fonts", "dist"],
  "exports": {
    ".": "./theme.css",
    "./board": {
      "import": "./dist/board.js",
      "types": "./dist/board.d.ts"
    },
    "./tokens": {
      "import": "./dist/tokens.js",
      "types": "./dist/tokens.d.ts"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@acm-uga/c4-board-ui": "workspace:*",
    "@fontsource/spline-sans": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
